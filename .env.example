# Copy this file to .env and fill in your values.

# --- Google Calendar (required) ---
# console.cloud.google.com -> create project -> enable "Google Calendar API"
# -> OAuth consent screen (External, add yourself as test user, then PUBLISH the app)
# -> Credentials -> Create credentials -> OAuth client ID -> type "Desktop app".
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 
# At least 32 random characters. Encrypts OAuth refresh/access tokens in SQLite.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TB_TOKEN_ENCRYPTION_KEY=

# --- AI (optional) ---
# Recommended: create a key at https://openrouter.ai/keys and add credits.
# The key stays server-side; never put it in VITE_* variables or commit your .env.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=TimeBlocking
# Optional public URL sent to OpenRouter for app attribution.
OPENROUTER_SITE_URL=

# Alternative direct-Gemini setup: set AI_PROVIDER=gemini and provide this key.
GEMINI_API_KEY=

# --- Server ---
PORT=4141
