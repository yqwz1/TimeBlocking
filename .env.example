# Copy this file to .env and fill in your values.

# --- Google Calendar (required) ---
# console.cloud.google.com -> create project -> enable "Google Calendar API"
# -> OAuth consent screen (External, add yourself as test user, then PUBLISH the app)
# -> Credentials -> Create credentials -> OAuth client ID -> type "Desktop app".
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 

# --- Gemini (optional, for the AI daily brief) ---
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run without AI. Everything else works.
GEMINI_API_KEY=

# --- Server ---
PORT=4141
